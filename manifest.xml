<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
    entry="WatchfaceApp"
    id="a3f4b2c1-e5d6-7a89-b0c1-d2e3f4a5b6c7"
    launcherIcon="@Drawables.LauncherIcon"
    minSdkVersion="3.2.0"
    name="@Strings.AppName"
    type="watchface"
    version="1.0.0"
  >
    <!-- Garmin Epix Pro Gen 2 (47mm & 51mm) -->
    <iq:products>
      <iq:product id="epixpro2" />
      <iq:product id="epixpro2size47" />
      <iq:product id="epixpro2size51" />
    </iq:products>

    <!-- Benötigte Berechtigungen -->
    <iq:permissions>
      <iq:uses-permission id="Fitness" />
      <iq:uses-permission id="Sensor" />
      <iq:uses-permission id="SensorHistory" />
      <iq:uses-permission id="UserProfile" />
      <iq:uses-permission id="Communications" />
    </iq:permissions>

    <!-- Genutzte Connect IQ APIs -->
    <iq:languages>
      <iq:language>deu</iq:language>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
